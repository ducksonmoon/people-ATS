# Production environment configuration

# Database
DATABASE_URL=${DATABASE_URL}

# Email
EMAIL_USER=${EMAIL_USER}
EMAIL_PASS=${EMAIL_PASS}

# CORS
CORS_ORIGIN=${CORS_ORIGIN}

# JWT Configuration
JWT_SECRET=${JWT_SECRET}
JWT_EXPIRES_IN=12h
REFRESH_TOKEN_EXPIRES_IN=30d
JWT_KEY_ID=${JWT_KEY_ID}

# Application
PORT=${PORT}
NODE_ENV=production 